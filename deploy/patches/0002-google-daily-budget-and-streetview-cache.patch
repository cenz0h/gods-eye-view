diff --git a/server/providers/cctv/streetview-cache.js b/server/providers/cctv/streetview-cache.js
new file mode 100644
index 0000000..1206aaa
--- /dev/null
+++ b/server/providers/cctv/streetview-cache.js
@@ -0,0 +1,120 @@
+import fsp from 'node:fs/promises';
+import path from 'node:path';
+import crypto from 'node:crypto';
+
+/**
+ * Disk cache for Google Street View static fallback frames.
+ *
+ * The CCTV frame route falls back to Street View whenever a camera's own feed
+ * is down, and the client re-requests frames on a refresh interval. Without a
+ * cache that bills a Street View Static request every few seconds for as long
+ * as the camera stays down, which is the failure mode most likely to run a
+ * self-hosted instance past Google's free allowance.
+ *
+ * Street View imagery for a fixed viewpoint is effectively static, so the
+ * entry is keyed by the rounded viewpoint and kept for a long TTL. Cached
+ * frames cost nothing, so only a miss reaches Google.
+ *
+ * Errors are swallowed: a cache problem must degrade to a live fetch, never
+ * break the frame route.
+ */
+
+const DEFAULT_TTL_MS = 7 * 24 * 60 * 60 * 1000;
+const MEM_MAX_ENTRIES = 64;
+
+/** @type {Map<string, {at:number, buf:Buffer, contentType:string}>} */
+const mem = new Map();
+
+function ttlMs() {
+  const raw = Number.parseInt(process.env.CCTV_STREETVIEW_CACHE_MS ?? '', 10);
+  return Number.isFinite(raw) && raw >= 0 ? raw : DEFAULT_TTL_MS;
+}
+
+function cacheDir() {
+  return path.join(process.cwd(), '.gev-cache', 'streetview');
+}
+
+/**
+ * Stable key for a viewpoint. Five decimal places is about a metre, far finer
+ * than Street View's own panorama spacing, so distinct cameras never collide
+ * while repeated requests for one camera always hit.
+ *
+ * @param {{lat:number, lon:number, heading:number, fov:number, pitch:number}} view
+ * @returns {string} Hex digest.
+ */
+export function streetViewCacheKey(view) {
+  const round = (n, dp) => (Number.isFinite(n) ? Number(n).toFixed(dp) : '0');
+  const raw = [
+    round(view.lat, 5),
+    round(view.lon, 5),
+    round(view.heading, 1),
+    round(view.fov, 1),
+    round(view.pitch, 1),
+  ].join(',');
+  return crypto.createHash('sha256').update(raw).digest('hex').slice(0, 32);
+}
+
+function memTrim() {
+  while (mem.size > MEM_MAX_ENTRIES) {
+    const oldest = mem.keys().next().value;
+    if (oldest === undefined) break;
+    mem.delete(oldest);
+  }
+}
+
+/**
+ * Look a viewpoint up. Returns null on a miss so the caller fetches upstream.
+ *
+ * @param {string} key - From `streetViewCacheKey`.
+ * @returns {Promise<{body:Buffer, contentType:string}|null>}
+ */
+export async function readStreetViewCache(key) {
+  const maxAge = ttlMs();
+  if (maxAge === 0) return null;
+
+  const hit = mem.get(key);
+  if (hit && Date.now() - hit.at < maxAge) {
+    return { body: hit.buf, contentType: hit.contentType };
+  }
+
+  try {
+    const base = path.join(cacheDir(), key);
+    const meta = JSON.parse(await fsp.readFile(`${base}.json`, 'utf8'));
+    if (!meta || !Number.isFinite(meta.at) || Date.now() - meta.at >= maxAge) {
+      return null;
+    }
+    const buf = await fsp.readFile(`${base}.img`);
+    const contentType =
+      typeof meta.contentType === 'string' ? meta.contentType : 'image/jpeg';
+    mem.set(key, { at: meta.at, buf, contentType });
+    memTrim();
+    return { body: buf, contentType };
+  } catch {
+    return null;
+  }
+}
+
+/**
+ * Store a fetched frame. Fire-and-forget: the caller should not await the
+ * write before answering the request.
+ *
+ * @param {string} key - From `streetViewCacheKey`.
+ * @param {Buffer} body - Image bytes.
+ * @param {string} contentType - Upstream content type.
+ * @returns {Promise<void>}
+ */
+export async function writeStreetViewCache(key, body, contentType) {
+  if (ttlMs() === 0) return;
+  const at = Date.now();
+  mem.set(key, { at, buf: body, contentType });
+  memTrim();
+  try {
+    const dir = cacheDir();
+    await fsp.mkdir(dir, { recursive: true });
+    const base = path.join(dir, key);
+    await fsp.writeFile(`${base}.img`, body);
+    await fsp.writeFile(`${base}.json`, JSON.stringify({ at, contentType }));
+  } catch (err) {
+    console.warn('[cctv-streetview] cache write failed:', err?.message || err);
+  }
+}
diff --git a/server/providers/common/daily-budget.js b/server/providers/common/daily-budget.js
new file mode 100644
index 0000000..ca9049b
--- /dev/null
+++ b/server/providers/common/daily-budget.js
@@ -0,0 +1,106 @@
+import fsp from 'node:fs/promises';
+import path from 'node:path';
+import {
+  utcDayKey,
+  normalizeBudget,
+  isOverBudget,
+} from '../../../src/data/tomtomTiles.js';
+
+/**
+ * Persistent per-UTC-day request counter for a metered upstream.
+ *
+ * Generalises the TomTom tile budget in ../traffic.js so other paid providers
+ * can share it. A per-minute rate limit cannot bound a day's spend: it caps
+ * the burst, not the total. This does the opposite, and survives restarts
+ * because the counter lives under `.gev-cache` (a mounted volume in the
+ * container image).
+ *
+ * Never throws: a missing, unreadable or corrupt counter file resets to zero
+ * for today rather than taking the endpoint down, and a failed write is
+ * warned about and ignored. The cost of that trade is at most one day's
+ * over-count after a disk problem.
+ *
+ * @param {object} options
+ * @param {string} options.name - Subdirectory under `.gev-cache`.
+ * @param {string} options.envVar - Env var holding the daily limit.
+ * @param {number} options.defaultLimit - Limit when the env var is unset.
+ * @returns {{check:()=>Promise<{over:boolean,count:number,limit:number,date:string}>,
+ *            record:()=>void, snapshot:()=>Promise<object>}}
+ */
+export function createDailyBudget({ name, envVar, defaultLimit }) {
+  const dir = path.join(process.cwd(), '.gev-cache', name);
+  const file = path.join(dir, 'budget.json');
+
+  /** @type {{date:string, count:number}|null} */
+  let state = null;
+  let loaded = false;
+
+  /** Limit for today. A value of 0 or below means unlimited (isOverBudget's contract). */
+  function limit() {
+    const raw = Number.parseInt(process.env[envVar] ?? '', 10);
+    return Number.isFinite(raw) ? raw : defaultLimit;
+  }
+
+  async function loadOnce() {
+    if (loaded) return;
+    loaded = true;
+    try {
+      const parsed = JSON.parse(await fsp.readFile(file, 'utf8'));
+      if (
+        parsed &&
+        typeof parsed.date === 'string' &&
+        Number.isFinite(parsed.count)
+      ) {
+        state = parsed;
+      }
+    } catch {
+      /* no counter yet, or it is unreadable: today starts at zero */
+    }
+  }
+
+  async function persist() {
+    try {
+      await fsp.mkdir(dir, { recursive: true });
+      await fsp.writeFile(file, JSON.stringify(state), 'utf8');
+    } catch (err) {
+      console.warn(`[${name}-budget] write failed:`, err?.message || err);
+    }
+  }
+
+  /** Roll the counter onto today (UTC) and return it. */
+  function current() {
+    state = normalizeBudget(state, utcDayKey());
+    return state;
+  }
+
+  return {
+    /** Load once, roll the day, and report whether today's allowance is spent. */
+    async check() {
+      await loadOnce();
+      const today = current();
+      const max = limit();
+      return {
+        over: isOverBudget(today, max),
+        count: today.count,
+        limit: max,
+        date: today.date,
+      };
+    },
+
+    /**
+     * Count one upstream attempt. Attempts rather than successes, because the
+     * provider bills a request whether or not we like the response.
+     */
+    record() {
+      current().count += 1;
+      void persist();
+    },
+
+    /** Current state for a status endpoint. */
+    async snapshot() {
+      await loadOnce();
+      const today = current();
+      return { date: today.date, count: today.count, budget: limit() };
+    },
+  };
+}
