# God's Eye View — Docker environment. Copy to gev.env next to compose.yaml.
# Full documentation of every key: ../../.env.example (upstream).
# HOST and the listen address are fixed by the image (0.0.0.0). Change the published port in
# compose.yaml, not here.
#
# Every key is OPTIONAL. With none set the globe still boots on keyless Esri World Imagery.

# --- Client-side map keys (FROZEN INTO THE BUILT BUNDLE; changing either triggers an automatic
# --- rebuild on the next container start; both are visible in browser devtools -> restrict them)
GOOGLE_MAPS_API_KEY=            # Google Photorealistic 3D Tiles (restrict by HTTP referrer)
CESIUM_ION_TOKEN=               # Cesium ion imagery/terrain (public assets:read token)

# --- Server-side keys (never leave the container) -------------------------
GOOGLE_MAPS_SERVER_API_KEY=     # Places context; falls back to GOOGLE_MAPS_API_KEY if empty
OPENAI_API_KEY=                 # Voice (Realtime) + HUD summaries. Voice needs HTTPS in the browser.
# OPENAI_REALTIME_MODEL=
# OPENAI_REALTIME_VOICE=
OPENSKY_AUTH_MODE=              # anon | basic | oauth | auto
OPENSKY_CLIENT_ID=              # OAuth (recommended). OPENSKY_CREDENTIALS_FILE is NOT supported in Docker.
OPENSKY_CLIENT_SECRET=
# OPENSKY_USERNAME=
# OPENSKY_PASSWORD=
AISSTREAM_API_KEY=              # live vessels (aisstream.io)
# AISSTREAM_BOUNDING_BOXES=
TOMTOM_API_KEY=                 # live traffic tiles
# TOMTOM_DAILY_TILE_BUDGET=
FIRMS_MAP_KEY=                  # NASA FIRMS active fires
LL2_API_TOKEN=                  # Launch Library 2 (optional, raises rate limit)
# TFL_APP_KEY=                  # TfL CCTV

# --- Abuse limits (RECOMMENDED: the container is reachable beyond localhost).
# --- Behind a reverse proxy all browsers share one IP, so these are global caps.
# --- They are NOT billing caps: set provider-side budgets too.
GEV_RATELIMIT_OPENAI_PER_MIN=30
GEV_RATELIMIT_GOOGLE_PER_MIN=60

# --- Container behaviour ---------------------------------------------------
# PUID=99
# PGID=100
# GEV_FORCE_REBUILD=1
# GEV_BUILD_NODE_OPTIONS=--max-old-space-size=2048
